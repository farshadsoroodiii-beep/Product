/*==================================================
    CAR MODEL (V1.2)
    Vehicle Management Core Model

    Facade Layer

    Delegates:
    - Query Operations
    - Admin Operations
    - Public Operations

    IMPORTANT:
    - This class is a facade only.
    - Business logic belongs to the delegated models.
    - Public Product queries are delegated to CarPublic.
==================================================*/

'use strict';

const BaseModel = require('../base.model');

const allowedFields =
    require('./shared/allowed-fields');

const CarQuery =
    require('./query/car-query.model');

const CarAdmin =
    require('./admin/car-admin.model');

const CarPublic =
    require('./public/car-public.model');

class Car extends BaseModel {

    /*==============================================
        ALLOWED UPDATE FIELDS
    ==============================================*/

    static allowedFields =
        allowedFields;

    /*==============================================
        QUERY METHODS
    ==============================================*/

    /*==============================================
        GET ALL CARS
        DELEGATED TO QUERY MODEL
    ==============================================*/

    static async getAll(options = {}) {

        return CarQuery.getAll(
            options
        );

    }

    /*==============================================
        GET CAR BY ID
        DELEGATED TO QUERY MODEL
    ==============================================*/

    static async getById(id) {

        return CarQuery.getById(
            id
        );

    }

    /*==============================================
        GET CAR BY SLUG
        DELEGATED TO QUERY MODEL
    ==============================================*/

    static async getBySlug(slug) {

        return CarQuery.getBySlug(
            slug
        );

    }

    /*==============================================
        CHECK CAR CODE EXISTS
        DELEGATED TO QUERY MODEL
    ==============================================*/

    static async existsByCarCode(
        carCode
    ) {

        return CarQuery.existsByCarCode(
            carCode
        );

    }

    /*==============================================
        ADMIN METHODS
    ==============================================*/

    /*==============================================
        CREATE CAR
        DELEGATED TO ADMIN MODEL
    ==============================================*/

    static async create(data) {

        return CarAdmin.create(
            data
        );

    }

    /*==============================================
        UPDATE CAR
        DELEGATED TO ADMIN MODEL
    ==============================================*/

    static async update(
        id,
        data
    ) {

        return CarAdmin.update(
            id,
            data
        );

    }

    /*==============================================
        DELETE CAR
        DELEGATED TO ADMIN MODEL
    ==============================================*/

    static async delete(id) {

        return CarAdmin.delete(
            id
        );

    }

    /*==============================================
        PUBLIC METHODS
    ==============================================*/

    /*==============================================
        GET ACTIVE CARS
        DELEGATED TO PUBLIC MODEL
    ==============================================*/

    static async getActive() {

        return CarPublic.getActive();

    }

    /*==============================================
        GET CARS BY SITE SECTION SLUG
        DELEGATED TO PUBLIC MODEL
    ==============================================*/

    static async getBySectionSlug(
        slug
    ) {

        return CarPublic.getBySectionSlug(
            slug
        );

    }

    /*==============================================
        GET PRODUCT BY SLUG
        PUBLIC PRODUCT PAGE

        DELEGATED TO:

            CarPublic.getProductBySlug()

        Product receives:
        - Complete public car data
        - Brand information
        - Main image
        - Background image
        - Gallery

        Product does NOT use:
            CarQuery.getBySlug()

        because the generic query may expose
        fields that are not intended for the
        public Product contract.
    ==============================================*/

    static async getProductBySlug(
        slug
    ) {

        return CarPublic.getProductBySlug(
            slug
        );

    }

    /*==============================================
        GET ADMIN DETAILS
        DELEGATED TO PUBLIC MODEL

        NOTE:
        This method is retained for the
        existing Admin Edit flow.

        It is intentionally separate from
        getProductBySlug().
    ==============================================*/

    static async getAdminDetails(
        id
    ) {

        return CarPublic.getAdminDetails(
            id
        );

    }

}

module.exports = Car;
