/*==================================================
    PUBLIC CAR CONTROLLER

    Responsibilities:
    - Public Cars List
    - Public Cars By Section
    - Public Product Details

    IMPORTANT:
    - This controller only orchestrates requests.
    - Business/query logic belongs to Car model.
    - Product uses the dedicated public Product query.
    - Admin endpoints are NOT handled here.
==================================================*/

'use strict';

const Car =
    require('../../../models/cars/car.model');

class CarController {

    /*==============================================
        GET ACTIVE CARS

        GET /api/cars
    ==============================================*/

    static async getCars(
        req,
        res
    ) {

        try {

            const cars =
                await Car.getActive();

            return res.status(200).json({

                success: true,

                data: cars

            });

        } catch (error) {

            console.error(
                'Public Cars List Error:',
                error
            );

            return res.status(500).json({

                success: false,

                message:
                    'Failed to load cars.'

            });

        }

    }

    /*==============================================
        GET CARS BY SITE SECTION

        GET /api/site-sections/:slug/cars
    ==============================================*/

    static async getCarsBySection(
        req,
        res
    ) {

        try {

            const {
                slug
            } = req.params;

            if (
                typeof slug !== 'string' ||
                !slug.trim()
            ) {

                return res.status(400).json({

                    success: false,

                    message:
                        'Section slug is required.'

                });

            }

            const cars =
                await Car.getBySectionSlug(
                    slug.trim()
                );

            return res.status(200).json({

                success: true,

                data: cars

            });

        } catch (error) {

            console.error(
                'Public Cars By Section Error:',
                error
            );

            return res.status(500).json({

                success: false,

                message:
                    'Failed to load section cars.'

            });

        }

    }

    /*==============================================
        GET PRODUCT BY SLUG

        GET /api/cars/:slug

        Product Contract:

        Request:
            /api/cars/:slug

        Response:
            {
                success: true,
                data: {
                    ...
                    gallery: [...]
                }
            }

        IMPORTANT:
        - Uses Car.getProductBySlug()
        - Does NOT use Car.getBySlug()
        - Does NOT use Admin Details
        - Only active/public cars are returned.
    ==============================================*/

    static async getCarBySlug(
        req,
        res
    ) {

        try {

            const {
                slug
            } = req.params;

            /*======================================
                VALIDATE SLUG
            ======================================*/

            if (
                typeof slug !== 'string' ||
                !slug.trim()
            ) {

                return res.status(400).json({

                    success: false,

                    message:
                        'Car slug is required.'

                });

            }

            const normalizedSlug =
                slug.trim();

            /*======================================
                LOAD PUBLIC PRODUCT
            ======================================*/

            const car =
                await Car.getProductBySlug(
                    normalizedSlug
                );

            /*======================================
                NOT FOUND
            ======================================*/

            if (!car) {

                return res.status(404).json({

                    success: false,

                    message:
                        'Car not found.'

                });

            }

            /*======================================
                SUCCESS
            ======================================*/

            return res.status(200).json({

                success: true,

                data: car

            });

        } catch (error) {

            console.error(
                'Public Product Error:',
                error
            );

            return res.status(500).json({

                success: false,

                message:
                    'Failed to load vehicle.'

            });

        }

    }

}

module.exports = CarController;
