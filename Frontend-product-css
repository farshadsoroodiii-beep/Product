/*==================================================
    PRODUCT PAGE CSS

    Vehicle Business Management System

    Responsibilities:
    - Public Product page layout
    - Product header
    - Vehicle media / gallery
    - Background image
    - Basic information
    - Technical information
    - Commercial information
    - Description
    - Manufacturer link
    - Product actions
    - Lightbox
    - Loading / Error states
    - Responsive layout

    Does NOT:
    - Control Header layout
    - Control Footer layout
    - Fetch data
    - Map API data
    - Manage Product state
==================================================*/

/*==================================================
    GLOBAL PRODUCT SCOPE
==================================================*/

.ci-page {
    width: min(1180px, calc(100% - 30px));
    margin: 30px auto 50px;
    padding: 0;
    box-sizing: border-box;
}

.ci-page *,
.ci-page *::before,
.ci-page *::after {
    box-sizing: border-box;
}

.ci-page a {
    text-decoration: none;
    color: inherit;
}

.ci-page img {
    max-width: 100%;
}

/*==================================================
    PRODUCT HEADER
==================================================*/

.ci-product-header {
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;

    background: #ffffff;
    border-radius: 18px;
    padding: 24px 28px;
    margin-bottom: 24px;

    box-shadow:
        0 8px 30px rgba(0, 0, 0, 0.07);

    border: 1px solid rgba(5, 58, 84, 0.08);
}

/*==================================================
    BRAND
==================================================*/

.ci-product-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;

    min-height: 70px;
    padding: 12px 18px;

    border-radius: 12px;
    background: linear-gradient(
        135deg,
        #f4f8fa,
        #ffffff
    );

    border: 1px solid rgba(5, 58, 84, 0.08);
}

.ci-product-brand img {
    width: 55px;
    height: 55px;
    object-fit: contain;
    border-radius: 8px;
}

.ci-product-brand span {
    font-size: 20px;
    font-weight: 800;
    color: #053a54;
}

/*==================================================
    PRODUCT TITLE
==================================================*/

.ci-product-title {
    min-width: 0;
}

.ci-product-title h1 {
    margin: 0;

    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.35;
    font-weight: 800;

    color: #053a54;

    overflow-wrap: anywhere;
}

.ci-product-subtitle {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    margin-top: 12px;
}

.ci-product-subtitle span {
    display: inline-flex;
    align-items: center;

    min-height: 34px;
    padding: 5px 14px;

    border-radius: 20px;

    background: #f1f6f8;
    color: #315568;

    font-size: 14px;
    font-weight: 600;
}

/*==================================================
    MEDIA SECTION
==================================================*/

.ci-media-section {
    width: 100%;
    margin-bottom: 28px;
}

/*==================================================
    MAIN IMAGE
==================================================*/

.ci-page .ci-mainbox {
    position: relative;

    width: 100%;
    min-height: 300px;

    overflow: hidden;

    border-radius: 18px;
    background:
        linear-gradient(
            135deg,
            #eef3f5,
            #ffffff
        );

    border: 1px solid rgba(5, 58, 84, 0.08);

    box-shadow:
        0 10px 35px rgba(0, 0, 0, 0.08);
}

.ci-page .ci-mainbox img {
    display: block;

    width: 100%;
    height: auto;

    max-height: 650px;

    object-fit: contain;

    border-radius: 18px;

    cursor: zoom-in;

    transition:
        transform 0.3s ease,
        opacity 0.3s ease;
}

@media (hover: hover) {

    .ci-page .ci-mainbox img:hover {
        transform: scale(1.01);
    }

}

/*==================================================
    MEDIA LOADING
==================================================*/

.ci-media-loading {
    position: absolute;

    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    color: #315568;

    font-size: 15px;
    font-weight: 600;

    background:
        linear-gradient(
            135deg,
            rgba(244, 248, 250, 0.96),
            rgba(255, 255, 255, 0.96)
        );

    z-index: 2;
}

.ci-media-loading[aria-hidden="true"] {
    pointer-events: none;
}

/*==================================================
    THUMBNAILS
==================================================*/

.ci-page .ci-thumbs {
    display: flex;
    align-items: center;

    width: 100%;

    gap: 12px;

    overflow-x: auto;
    overflow-y: hidden;

    margin-top: 14px;
    margin-bottom: 22px;

    padding: 4px 4px 10px;

    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
}

.ci-page .ci-thumbs::-webkit-scrollbar {
    height: 7px;
}

.ci-page .ci-thumbs::-webkit-scrollbar-track {
    background: #edf2f4;
    border-radius: 10px;
}

.ci-page .ci-thumbs::-webkit-scrollbar-thumb {
    background: #6f8b99;
    border-radius: 10px;
}

.ci-page .ci-thumbs img {
    flex: 0 0 auto;

    width: 105px;
    height: 78px;

    object-fit: cover;

    border-radius: 10px;

    border: 2px solid transparent;

    background: #ffffff;

    cursor: pointer;

    opacity: 0.78;

    transition:
        transform 0.2s ease,
        opacity 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.ci-page .ci-thumbs img:hover {
    opacity: 1;
    transform: translateY(-2px);
}

.ci-page .ci-thumbs img.ci-selected {
    opacity: 1;

    border-color: #053a54;

    box-shadow:
        0 4px 14px rgba(5, 58, 84, 0.20);

    transform: translateY(-2px);
}

/*==================================================
    NO IMAGE MESSAGE
==================================================*/

.ci-page .ci-thumbs:empty::after {
    content: "تصویری برای نمایش وجود ندارد";

    display: block;

    width: 100%;

    padding: 16px;

    text-align: center;

    color: #71838c;

    font-size: 14px;

    background: #f5f8f9;

    border-radius: 10px;
}

/*==================================================
    BACKGROUND IMAGE
==================================================*/

.ci-background-media {
    margin-top: 24px;

    padding: 20px;

    background: #ffffff;

    border-radius: 16px;

    border: 1px solid rgba(5, 58, 84, 0.08);

    box-shadow:
        0 6px 24px rgba(0, 0, 0, 0.05);
}

.ci-background-media[hidden] {
    display: none;
}

.ci-section-title {
    margin-bottom: 14px;

    color: #053a54;

    font-size: 18px;
    font-weight: 800;
}

.ci-background-image-wrap {
    overflow: hidden;

    border-radius: 12px;

    background: #f3f6f7;
}

.ci-background-image-wrap img {
    display: block;

    width: 100%;
    max-height: 500px;

    object-fit: cover;

    border-radius: 12px;
}

/*==================================================
    PRODUCT INFORMATION
==================================================*/

.ci-product-info {
    display: flex;
    flex-direction: column;

    gap: 22px;

    width: 100%;
}

/*==================================================
    INFORMATION SECTION
==================================================*/

.ci-info-section {
    width: 100%;

    padding: 24px;

    background: #ffffff;

    border-radius: 18px;

    border: 1px solid rgba(5, 58, 84, 0.08);

    box-shadow:
        0 7px 26px rgba(0, 0, 0, 0.055);
}

.ci-info-section h2 {
    position: relative;

    margin: 0 0 20px;

    padding-right: 14px;

    color: #053a54;

    font-size: 22px;
    line-height: 1.4;
    font-weight: 800;
}

.ci-info-section h2::before {
    content: "";

    position: absolute;

    right: 0;
    top: 50%;

    width: 4px;
    height: 28px;

    transform: translateY(-50%);

    border-radius: 4px;

    background: #016a90;
}

/*==================================================
    INFORMATION GRID
==================================================*/

.ci-info-grid {
    display: grid;

    grid-template-columns:
        repeat(
            2,
            minmax(0, 1fr)
        );

    gap: 14px;
}

/*==================================================
    INFORMATION ITEM
==================================================*/

.ci-info-item {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 18px;

    min-height: 58px;

    padding: 12px 16px;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            #f7fafb,
            #ffffff
        );

    border: 1px solid rgba(5, 58, 84, 0.07);
}

.ci-info-item .ci-label {
    flex: 0 0 auto;

    color: #6b7d86;

    font-size: 14px;
    font-weight: 600;
}

.ci-info-item strong {
    min-width: 0;

    color: #183e4e;

    font-size: 15px;
    font-weight: 750;

    text-align: left;

    overflow-wrap: anywhere;
}

/*==================================================
    PRICE
==================================================*/

.ci-price-item {
    background:
        linear-gradient(
            135deg,
            #eef8fb,
            #ffffff
        );

    border-color: rgba(1, 106, 144, 0.15);
}

.ci-price-item strong {
    color: #016a90;

    font-size: 18px;
    font-weight: 850;
}

/*==================================================
    DESCRIPTION
==================================================*/

.ci-description {
    min-height: 80px;

    padding: 18px 20px;

    border-radius: 12px;

    background: #f7fafb;

    border: 1px solid rgba(5, 58, 84, 0.07);

    color: #405963;

    font-size: 15px;

    line-height: 2;

    white-space: pre-line;

    overflow-wrap: anywhere;
}

/*==================================================
    MANUFACTURER
==================================================*/

.ci-manufacturer-section[hidden] {
    display: none;
}

.ci-manufacturer-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 46px;

    padding: 10px 20px;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            #053a54,
            #016a90
        );

    color: #ffffff !important;

    font-size: 14px;
    font-weight: 700;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

@media (hover: hover) {

    .ci-manufacturer-link:hover {
        transform: translateY(-2px);

        box-shadow:
            0 6px 18px rgba(5, 58, 84, 0.20);
    }

}

/*==================================================
    ACTIONS
==================================================*/

.ci-actions-section {
    width: 100%;

    margin-top: 28px;
}

.ci-page .ci-buttons-wrap {
    display: flex;
    flex-wrap: wrap;

    gap: 14px;

    width: 100%;

    justify-content: center;
}

.ci-page .ci-buttons-wrap .ci-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 1 1 220px;

    min-height: 52px;

    padding: 12px 24px;

    border: none;
    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            #053a54,
            #016a90
        );

    color: #ffffff;

    cursor: pointer;

    font-size: 15px;
    font-weight: 750;

    text-align: center;

    box-shadow:
        0 5px 16px rgba(5, 58, 84, 0.12);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

@media (hover: hover) {

    .ci-page .ci-buttons-wrap .ci-btn:hover {
        transform: translateY(-3px);

        box-shadow:
            0 9px 24px rgba(5, 58, 84, 0.20);
    }

}

.ci-page .ci-buttons-wrap .ci-btn:active {
    transform: scale(0.98);
}

/*==================================================
    LIGHTBOX
==================================================*/

.ci-page .ci-lightbox {
    display: none;

    position: fixed;

    inset: 0;

    width: 100%;
    height: 100%;

    padding: 60px 70px;

    background:
        rgba(0, 0, 0, 0.90);

    justify-content: center;
    align-items: center;

    z-index: 10000;
}

.ci-page .ci-lightbox.ci-active {
    display: flex;
}

.ci-page .ci-lightbox > img {
    display: block;

    max-width: min(92vw, 1400px);
    max-height: 88vh;

    width: auto;
    height: auto;

    object-fit: contain;

    border-radius: 12px;

    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.40);
}

/*==================================================
    LIGHTBOX CLOSE
==================================================*/

.ci-page .ci-lightbox .ci-close-btn {
    position: absolute;

    top: 18px;
    right: 22px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 48px;
    height: 48px;

    padding: 0;

    border: none;
    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.12);

    color: #ffffff;

    font-size: 25px;
    line-height: 1;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.ci-page .ci-lightbox .ci-close-btn:hover {
    background:
        rgba(255, 255, 255, 0.22);

    transform: scale(1.05);
}

/*==================================================
    LIGHTBOX NAVIGATION
==================================================*/

.ci-page .ci-lightbox .ci-nav-arrow {
    position: absolute;

    top: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 52px;
    height: 52px;

    padding: 0;

    transform: translateY(-50%);

    border: none;
    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.12);

    color: #ffffff;

    font-size: 28px;
    line-height: 1;

    cursor: pointer;

    user-select: none;

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.ci-page .ci-lightbox .ci-nav-arrow:hover {
    background:
        rgba(255, 255, 255, 0.22);

    transform:
        translateY(-50%) scale(1.05);
}

.ci-page .ci-lightbox .ci-prev {
    left: 20px;
}

.ci-page .ci-lightbox .ci-next {
    right: 20px;
}

/*==================================================
    ERROR
==================================================*/

.ci-product-error {
    width: 100%;

    margin-top: 24px;

    padding: 35px 24px;

    text-align: center;

    background: #ffffff;

    border-radius: 18px;

    border: 1px solid rgba(180, 50, 50, 0.12);

    box-shadow:
        0 7px 25px rgba(0, 0, 0, 0.06);
}

.ci-product-error[hidden] {
    display: none;
}

.ci-product-error h2 {
    margin: 0 0 12px;

    color: #9d3030;

    font-size: 21px;
}

.ci-product-error p {
    margin: 0 0 22px;

    color: #68777e;

    line-height: 1.9;
}

.ci-product-error .ci-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 46px;

    padding: 10px 22px;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            #053a54,
            #016a90
        );

    color: #ffffff;

    font-weight: 700;
}

/*==================================================
    TABLET
==================================================*/

@media (max-width: 900px) {

    .ci-page {
        width: min(
            100% - 24px,
            760px
        );

        margin-top: 22px;
    }

    .ci-product-header {
        grid-template-columns: 1fr;

        gap: 16px;

        padding: 20px;
    }

    .ci-product-brand {
        justify-content: flex-start;
    }

    .ci-info-grid {
        grid-template-columns: 1fr;
    }

    .ci-info-item {
        min-height: 54px;
    }

}

/*==================================================
    MOBILE
==================================================*/

@media (max-width: 600px) {

    .ci-page {
        width: calc(100% - 18px);

        margin: 14px auto 30px;
    }

    /*----------------------------------------------
        Product Header
    ----------------------------------------------*/

    .ci-product-header {
        padding: 16px;

        border-radius: 14px;

        margin-bottom: 16px;
    }

    .ci-product-brand {
        min-height: 58px;

        padding: 9px 12px;

        border-radius: 10px;
    }

    .ci-product-brand img {
        width: 44px;
        height: 44px;
    }

    .ci-product-brand span {
        font-size: 17px;
    }

    .ci-product-title h1 {
        font-size: 24px;

        line-height: 1.45;
    }

    .ci-product-subtitle {
        gap: 7px;

        margin-top: 9px;
    }

    .ci-product-subtitle span {
        min-height: 30px;

        padding: 4px 10px;

        font-size: 12px;
    }

    /*----------------------------------------------
        Main Image
    ----------------------------------------------*/

    .ci-page .ci-mainbox {
        min-height: 210px;

        border-radius: 14px;
    }

    .ci-page .ci-mainbox img {
        min-height: 210px;

        object-fit: contain;

        border-radius: 14px;
    }

    /*----------------------------------------------
        Thumbnails
    ----------------------------------------------*/

    .ci-page .ci-thumbs {
        gap: 8px;

        margin-top: 10px;

        padding-bottom: 8px;
    }

    .ci-page .ci-thumbs img {
        width: 82px;
        height: 62px;

        border-radius: 8px;
    }

    /*----------------------------------------------
        Information Sections
    ----------------------------------------------*/

    .ci-product-info {
        gap: 14px;
    }

    .ci-info-section {
        padding: 17px 14px;

        border-radius: 14px;
    }

    .ci-info-section h2 {
        margin-bottom: 14px;

        font-size: 19px;
    }

    .ci-info-section h2::before {
        height: 23px;
        width: 3px;
    }

    .ci-info-grid {
        gap: 9px;
    }

    .ci-info-item {
        flex-direction: column;

        align-items: flex-start;

        justify-content: center;

        gap: 5px;

        min-height: auto;

        padding: 11px 13px;

        border-radius: 9px;
    }

    .ci-info-item .ci-label {
        font-size: 12px;
    }

    .ci-info-item strong {
        width: 100%;

        font-size: 14px;

        text-align: right;
    }

    .ci-price-item strong {
        font-size: 17px;
    }

    /*----------------------------------------------
        Description
    ----------------------------------------------*/

    .ci-description {
        padding: 14px;

        font-size: 14px;

        line-height: 1.95;
    }

    /*----------------------------------------------
        Background
    ----------------------------------------------*/

    .ci-background-media {
        padding: 14px;

        border-radius: 14px;
    }

    .ci-section-title {
        font-size: 16px;
    }

    /*----------------------------------------------
        Actions
    ----------------------------------------------*/

    .ci-actions-section {
        margin-top: 18px;
    }

    .ci-page .ci-buttons-wrap {
        flex-direction: column;

        gap: 9px;
    }

    .ci-page .ci-buttons-wrap .ci-btn {
        width: 100%;

        flex: 1 1 auto;

        min-height: 48px;

        font-size: 14px;
    }

    /*----------------------------------------------
        Manufacturer
    ----------------------------------------------*/

    .ci-manufacturer-link {
        width: 100%;

        min-height: 44px;

        font-size: 13px;
    }

    /*----------------------------------------------
        Lightbox
    ----------------------------------------------*/

    .ci-page .ci-lightbox {
        padding: 55px 12px 40px;
    }

    .ci-page .ci-lightbox > img {
        max-width: 96vw;
        max-height: 78vh;

        border-radius: 8px;
    }

    .ci-page .ci-lightbox .ci-close-btn {
        top: 10px;
        right: 10px;

        width: 42px;
        height: 42px;

        font-size: 21px;
    }

    .ci-page .ci-lightbox .ci-nav-arrow {
        top: auto;
        bottom: 12px;

        width: 44px;
        height: 44px;

        font-size: 23px;

        transform: none;
    }

    .ci-page .ci-lightbox .ci-nav-arrow:hover {
        transform: scale(1.05);
    }

    .ci-page .ci-lightbox .ci-prev {
        left: 18px;
    }

    .ci-page .ci-lightbox .ci-next {
        right: 18px;
    }

    /*----------------------------------------------
        Error
    ----------------------------------------------*/

    .ci-product-error {
        padding: 25px 15px;

        border-radius: 14px;
    }

    .ci-product-error h2 {
        font-size: 18px;
    }

    .ci-product-error p {
        font-size: 13px;
    }

}

/*==================================================
    VERY SMALL DEVICES
==================================================*/

@media (max-width: 380px) {

    .ci-page {
        width: calc(100% - 12px);
    }

    .ci-product-title h1 {
        font-size: 21px;
    }

    .ci-page .ci-thumbs img {
        width: 72px;
        height: 55px;
    }

    .ci-info-item {
        padding: 10px 11px;
    }

    .ci-info-item strong {
        font-size: 13px;
    }

}

/*==================================================
    ACCESSIBILITY
==================================================*/

.ci-page .ci-btn:focus-visible,
.ci-page .ci-thumbs img:focus-visible,
.ci-page .ci-lightbox button:focus-visible,
.ci-page .ci-manufacturer-link:focus-visible {
    outline: 3px solid rgba(1, 106, 144, 0.35);
    outline-offset: 3px;
}

/*==================================================
    REDUCED MOTION
==================================================*/

@media (prefers-reduced-motion: reduce) {

    .ci-page *,
    .ci-page *::before,
    .ci-page *::after {
        scroll-behavior: auto !important;

        transition: none !important;
    }

}
