function mapProduct(data) {

    const rawGallery =
        Array.isArray(data.gallery)
            ? data.gallery
            : [];

    const gallery =
        rawGallery
            .map((item, index) => {

                if (
                    typeof item === 'string'
                ) {
                    return {
                        id: null,
                        imagePath: item,
                        sortOrder: index + 1
                    };
                }

                return {
                    id:
                        item?.id ?? null,

                    imagePath:
                        item?.image_path ||
                        item?.imagePath ||
                        item?.path ||
                        '',

                    sortOrder:
                        Number.isFinite(
                            Number(
                                item?.sort_order
                            )
                        )
                            ? Number(
                                item.sort_order
                            )
                            : index + 1
                };

            })
            .filter(
                item => item.imagePath
            )
            .sort(
                (a, b) =>
                    a.sortOrder -
                    b.sortOrder
            )
            .map(
                item => ({
                    ...item,
                    url:
                        buildImageUrl(
                            item.imagePath
                        )
                })
            )
            .filter(
                item => item.url
            );

    return {

        id:
            data.id ?? null,

        brandId:
            data.brand_id ?? null,

        brandName:
            data.brand_name || '',

        brandSlug:
            data.brand_slug || '',

        brandLogo:
            data.brand_logo || '',

        brandCountry:
            data.brand_country || '',

        model:
            data.model || '',

        trim:
            data.trim || '',

        displayTitle:
            data.display_title ||
            data.title ||
            '',

        carCode:
            data.car_code || '',

        slug:
            data.slug || '',

        condition:
            data.condition || '',

        status:
            data.status || '',

        year:
            data.year ?? '',

        engineType:
            data.engine_type || '',

        engineVolume:
            data.engine_volume ?? '',

        cylinders:
            data.cylinders ?? '',

        horsepower:
            data.horsepower ?? '',

        gearbox:
            data.gearbox || '',

        driveType:
            data.drive_type || '',

        fuel:
            data.fuel || '',

        mileage:
            data.mileage ?? '',

        color:
            data.color || '',

        price:
            data.price ?? '',

        oldPrice:
            data.old_price ?? '',

        currency:
            data.currency || '',

        priceStatus:
            data.price_status || '',

        description:
            data.description || '',

        mainImage:
            buildImageUrl(
                data.main_image
            ),

        backgroundImage:
            buildImageUrl(
                data.background_image
            ),

        manufacturerUrl:
            data.manufacturer_url || '',

        isActive:
            data.is_active,

        publishedAt:
            data.published_at || '',

        metaTitle:
            data.meta_title || '',

        metaDescription:
            data.meta_description || '',

        metaImage:
            buildImageUrl(
                data.meta_image
            ),

        gallery
    };
}

