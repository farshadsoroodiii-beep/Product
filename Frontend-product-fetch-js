==================================================*/

async function fetchWithTimeout(
    url,
    timeout = REQUEST_TIMEOUT
) {

    const controller =
        new AbortController();

    const timer =
        setTimeout(
            () => controller.abort(),
            timeout
        );

    try {

        const response =
            await fetch(
                url,
                {
                    method: 'GET',
                    headers: {
                        'Accept':
                            'application/json'
                    },
                    signal:
                        controller.signal
                }
            );

        return response;

    } finally {

        clearTimeout(timer);
    }
}

async function fetchProduct(slug) {

    const url =
        `${API_BASE}/cars/${encodeURIComponent(slug)}`;

    if (
        CONFIG.DEBUG?.LOG_REQUESTS
    ) {
        console.log(
            'PRODUCT REQUEST:',
            url
        );
    }

    const response =
        await fetchWithTimeout(url);

    if (!response.ok) {

        if (
            response.status === 404
        ) {
            throw new Error(
                'PRODUCT_NOT_FOUND'
            );
        }

        throw new Error(
            `PRODUCT_API_ERROR_${response.status}`
        );
    }

    const result =
        await response.json();

    if (
        CONFIG.DEBUG?.LOG_RESPONSES
    ) {
        console.log(
            'PRODUCT RESPONSE:',
            result
        );
    }

    if (
        !result ||
        result.success !== true
    ) {
        throw new Error(
            'PRODUCT_INVALID_RESPONSE'
        );
    }

    if (!result.data) {
        throw new Error(
            'PRODUCT_EMPTY_DATA'
        );
    }

    return result.data;
}

