    };
}

function handleOrder() {

    if (!currentCar) {
        return;
    }

    const orderData =
        prepareOrderData();

    if (!orderData) {
        return;
    }

    try {

        localStorage.setItem(
            'selectedCar',
            JSON.stringify(
                orderData
            )
        );

    } catch (error) {

        console.error(
            'PRODUCT: Unable to store selected car.',
            error
        );

        return;
    }

    window.location.href =
        'order.html';
}

/*==================================================
    EVENT BINDING
==================================================*/

function bindEvents() {

    if (eventsBound) {
        return;
    }

    eventsBound = true;

    /*----------------------------------------------
        Gallery
    ----------------------------------------------*/

    elements.thumbs?.addEventListener(
        'click',
        event => {

            const target =
                event.target;

            if (
                !target ||
                target.tagName !== 'IMG'
            ) {
                return;
            }

            const index =
                Number(
                    target.dataset.index
                );

            if (
                Number.isInteger(index)
            ) {

                updateMainImage(
                    index
                );
            }
        }
    );

    elements.thumbs?.addEventListener(
        'keydown',
        event => {

            const target =
                event.target;

            if (
                !target ||
                target.tagName !== 'IMG'
            ) {
                return;
            }

            if (
                event.key !== 'Enter' &&
                event.key !== ' '
            ) {
                return;
            }

            event.preventDefault();

            const index =
                Number(
                    target.dataset.index
                );

            if (
                Number.isInteger(index)
            ) {

                updateMainImage(
                    index
                );
            }
        }
    );

    /*----------------------------------------------
        Main Image
    ----------------------------------------------*/

    elements.mainImage?.addEventListener(
        'click',
        openLightbox
    );

    /*----------------------------------------------
        Lightbox
    ----------------------------------------------*/

    elements.lightboxClose?.addEventListener(
        'click',
        closeLightbox
    );

    elements.lightbox?.addEventListener(
        'click',
        event => {

            if (
                event.target ===
                elements.lightbox
            ) {
                closeLightbox();
            }
        }
    );

    elements.lightboxPrev?.addEventListener(
        'click',
        showPreviousImage
    );

    elements.lightboxNext?.addEventListener(
        'click',
        showNextImage
    );

    document.addEventListener(
        'keydown',
        event => {

            if (
                !elements.lightbox ||
                !elements.lightbox.classList.contains(
                    'ci-active'
                )
            ) {
                return;
            }

            if (
                event.key === 'Escape'
            ) {

                closeLightbox();

                return;
            }

            if (
                event.key === 'ArrowLeft'
            ) {

                showNextImage();

                return;
            }

            if (
                event.key === 'ArrowRight'
            ) {

                showPreviousImage();
            }
        }
    );

    /*----------------------------------------------
        Order
    ----------------------------------------------*/

    elements.orderButton?.addEventListener(
        'click',
        event => {

            event.preventDefault();

            handleOrder();
        }
    );

    /*----------------------------------------------
        Back
    ----------------------------------------------*/

    elements.backButton?.addEventListener(
        'click',
        event => {

            event.preventDefault();

            if (
                window.history.length > 1
            ) {

                window.history.back();

            } else {

                window.location.href =
                    'index.html';
            }
        }
    );
}

/*==================================================
    RENDER PRODUCT
==================================================*/

function renderProduct(data) {

    const car =
        mapProduct(data);

    currentCar =
        car;

    renderHeader(car);

    renderBasicInformation(car);

    renderTechnicalInformation(car);

    renderCommercialInformation(car);

    renderDescription(car);

    renderManufacturer(car);

    renderMainImage(car);

    renderGallery(car);

    renderBackgroundImage(car);

    renderSEO(car);

    page.dataset.productSlug =
        car.slug || '';

    page.dataset.productId =
        car.id || '';

    hideError();
}

/*==================================================
    LOAD PRODUCT
==================================================*/

async function loadProduct() {

    setLoading(true);

    hideError();

    const slug =
        getSlugFromUrl();

    if (!slug) {

        setLoading(false);

        showError(
            'شناسه خودرو در آدرس صفحه مشخص نشده است.'
        );

        return;
    }

    try {

        const data =
            await fetchProduct(slug);

        renderProduct(data);

    } catch (error) {

        console.error(
            'PRODUCT LOAD ERROR:',
            error
        );

        if (
            error?.name ===
            'AbortError'
        ) {

            showError(
                'زمان دریافت اطلاعات خودرو به پایان رسید. لطفاً دوباره تلاش کنید.'
            );

        } else if (
            error?.message ===
            'PRODUCT_NOT_FOUND'
        ) {

            showError(
                'خودروی مورد نظر پیدا نشد یا در حال حاضر برای نمایش عمومی فعال نیست.'
            );

        } else {

            showError(
                'خطا در دریافت اطلاعات خودرو. لطفاً دوباره تلاش کنید.'
            );
        }

    } finally {

        setLoading(false);
    }
}

/*==================================================
    INITIALIZE
==================================================*/

function init() {

    bindEvents();

    loadProduct();
}

init();

})();
