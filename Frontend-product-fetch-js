/*==================================================
    GALLERY
==================================================*/

function renderGallery(car) {

    if (!elements.thumbs) {
        return;
    }

    galleryImages = [];

    /*
        Main Image is the first visual image.
        Gallery images follow in their persisted
        sort_order.
    */

    if (car.mainImage) {

        galleryImages.push({
            url: car.mainImage,
            type: 'main',
            id: null,
            sortOrder: 0
        });
    }

    car.gallery.forEach(
        image => {

            /*
                Prevent duplicate main image
                when the same physical path
                also exists in gallery.
            */

            if (
                car.mainImage &&
                image.url === car.mainImage
            ) {
                return;
            }

            galleryImages.push({
                url: image.url,
                type: 'gallery',
                id: image.id,
                sortOrder: image.sortOrder
            });
        }
    );

    elements.thumbs.innerHTML = '';

    if (!galleryImages.length) {

        currentImageIndex = 0;

        if (elements.mainImage) {

            elements.mainImage.removeAttribute(
                'src'
            );

            elements.mainImage.alt =
                'تصویری موجود نیست';
        }

        updateLightboxButtons();

        return;
    }

    currentImageIndex = 0;

    galleryImages.forEach(
        (image, index) => {

            const thumb =
                document.createElement(
                    'img'
                );

            thumb.src =
                image.url;

            thumb.alt =
                `${car.displayTitle || car.model || 'Vehicle'} - ${index + 1}`;

            thumb.dataset.index =
                String(index);

            thumb.tabIndex = 0;

            if (index === 0) {
                thumb.classList.add(
                    'ci-selected'
                );
            }

            elements.thumbs.appendChild(
                thumb
            );
        }
    );

    updateMainImage(
        0,
        false
    );
}

/*==================================================
    MAIN IMAGE UPDATE
==================================================*/

function updateMainImage(
    index,
    smooth = true
) {

    if (
        !galleryImages.length ||
        !elements.mainImage
    ) {
        return;
    }

    if (
        index < 0 ||
        index >= galleryImages.length
    ) {
        return;
    }

    currentImageIndex =
        index;

    const image =
        galleryImages[
            currentImageIndex
        ];

    elements.mainImage.src =
        image.url;

    elements.thumbs
        ?.querySelectorAll('img')
        .forEach(
            thumb => {

                thumb.classList.remove(
                    'ci-selected'
                );
            }
        );

    const selectedThumb =
        elements.thumbs?.querySelector(
            `img[data-index="${currentImageIndex}"]`
        );

    if (selectedThumb) {

        selectedThumb.classList.add(
            'ci-selected'
        );

        if (smooth) {

            selectedThumb.scrollIntoView({
                behavior: 'smooth',
                block: 'nearest',
                inline: 'center'
            });

        }
    }

    updateLightboxButtons();

    if (
        elements.lightbox &&
        elements.lightbox.classList.contains(
            'ci-active'
        )
    ) {
        updateLightboxImage();
    }
}

/*==================================================
    LIGHTBOX
==================================================*/

function openLightbox() {

    if (
        !elements.lightbox ||
        !galleryImages.length
    ) {
        return;
    }

    elements.lightbox.classList.add(
        'ci-active'
    );

    elements.lightbox.setAttribute(
        'aria-hidden',
        'false'
    );

    updateLightboxImage();

    document.body.style.overflow =
        'hidden';
}

function closeLightbox() {

    if (!elements.lightbox) {
        return;
    }

    elements.lightbox.classList.remove(
        'ci-active'
    );

    elements.lightbox.setAttribute(
        'aria-hidden',
        'true'
    );

    document.body.style.overflow =
        '';
}

function updateLightboxImage() {

    if (
        !elements.lightboxImage ||
        !galleryImages.length
    ) {
        return;
    }

    const image =
        galleryImages[
            currentImageIndex
        ];

    if (!image) {
        return;
    }

    elements.lightboxImage.src =
        image.url;

    elements.lightboxImage.alt =
        `Vehicle image ${currentImageIndex + 1}`;
}

function updateLightboxButtons() {

    const hasImages =
        galleryImages.length > 0;

    if (elements.lightboxPrev) {

        elements.lightboxPrev.disabled =
            !hasImages ||
            currentImageIndex <= 0;
    }

    if (elements.lightboxNext) {

        elements.lightboxNext.disabled =
            !hasImages ||
            currentImageIndex >=
            galleryImages.length - 1;
    }
}

function showPreviousImage() {

    if (
        currentImageIndex <= 0
    ) {
        return;
    }

    updateMainImage(
        currentImageIndex - 1
    );
}

function showNextImage() {

    if (
        currentImageIndex >=
        galleryImages.length - 1
    ) {
        return;
    }

    updateMainImage(
        currentImageIndex + 1
    );
}

