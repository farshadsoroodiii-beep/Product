function renderSEO(car) {

    const title =
        car.metaTitle ||
        car.displayTitle ||
        car.model ||
        'Vehicle';

    const description =
        car.metaDescription ||
        car.description ||
        '';

    if (elements.pageTitle) {

        elements.pageTitle.textContent =
            title;
    }

    if (
        elements.metaDescription
    ) {

        elements.metaDescription.setAttribute(
            'content',
            description
        );
    }

    if (
        elements.metaKeywords
    ) {

        const keywords = [
            car.brandName,
            car.model,
            car.trim,
            car.condition
        ]
            .filter(Boolean)
            .join(', ');

        elements.metaKeywords.setAttribute(
            'content',
            keywords
        );
    }

    if (elements.ogTitle) {

        elements.ogTitle.setAttribute(
            'content',
            title
        );
    }

    if (elements.ogDescription) {

        elements.ogDescription.setAttribute(
            'content',
            description
        );
    }

    if (
        elements.ogImage &&
        car.metaImage
    ) {

        elements.ogImage.setAttribute(
            'content',
            car.metaImage
        );
    }
}

