function normalizeText(value) {

    if (
        value === null ||
        value === undefined
    ) {
        return '';
    }

    return String(value).trim();
}

function displayValue(value) {

    const normalized =
        normalizeText(value);

    return normalized || '-';
}

function formatNumber(value) {

    if (
        value === null ||
        value === undefined ||
        value === ''
    ) {
        return '';
    }

    const number =
        Number(value);

    if (!Number.isFinite(number)) {
        return normalizeText(value);
    }

    return new Intl.NumberFormat(
        'fa-IR'
    ).format(number);
}

function buildImageUrl(imagePath) {

    const value =
        normalizeText(imagePath);

    if (!value) {
        return '';
    }

    /*----------------------------------------------
        Full URL
    ----------------------------------------------*/

    if (
        value.startsWith('http://') ||
        value.startsWith('https://')
    ) {
        return value;
    }

    /*
        Protocol-relative URL
    */

    if (value.startsWith('//')) {
        return `${window.location.protocol}${value}`;
    }

    /*
        Windows path compatibility
    */

    let normalized =
        value.replace(/\\/g, '/');

    /*
        Already contains uploads root
    */

    if (
        normalized.startsWith('/uploads/')
    ) {
        return `${CONFIG.API.BASE_URL}${normalized}`;
    }

    if (
        normalized.startsWith('uploads/')
    ) {
        return `${CONFIG.API.BASE_URL}/${normalized}`;
    }

    /*
        Leading slash
    */

    normalized =
        normalized.replace(/^\/+/, '');

    /*
        Canonical DB path:
        cars/133/main-images/...
    */

    const uploadsBase =
        UPLOADS_URL.replace(/\/+$/, '');

    return `${uploadsBase}/${normalized}`;
}

function getSlugFromUrl() {

    const params =
        new URLSearchParams(
            window.location.search
        );

    return normalizeText(
        params.get('slug')
    );
}

/*==================================================
